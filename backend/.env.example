# Copy to .env and fill in for your machine. Never commit the real .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=dawa_verify
POSTGRES_USER=dawa_verify
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Qwen / ModelScope credentials (from the Hack for Humanity credits email).
# While QWEN_API_KEY is blank, the app uses the documented stub extractor
# (see verification/extraction.py) instead of calling the real API.
#
QWEN_API_KEY=
QWEN_API_BASE=https://api-inference.modelscope.ai/v1
QWEN_MODEL=Qwen-Ambassador/Qwen3.8-Max

# Azure Cognitive Services Speech (Swahili TTS, ADR 0006). Free F0 tier is
# enough for a demo. AZURE_SPEECH_REGION is the resource region, e.g. "eastus".
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=sw-KE-RafikiNeural

# Optional: override if your frontend runs on a different origin than the
# defaults baked into settings.py (localhost/127.0.0.1/0.0.0.0 on ports
# 3000, 5500, 8080, 5173). Comma-separated, no trailing slash. Leave this
# line OUT ENTIRELY (don't just leave it blank) to use those defaults --
# a blank value now correctly falls back to the default too, but omitting
# the line is clearer.
